# Local dependencies and VCS data
/node_modules/
/.git/

# Local-only workspaces that neither the remote test run nor the runtime needs.
# tests/, tools/, .agents/ MUST upload: the remote build runs `node --test`
# and those hold the suite plus the fixtures it reads. Only dist/ is served.
/.agent/
/.claude/
/docs/
/tmp/

# Never upload a stale locally-built output; the remote build regenerates dist/.
/dist/

# Local source PDFs used only for audit/research.
*.pdf

# Local environment and OS/editor noise
.env*
!.env.example
.DS_Store
Thumbs.db
